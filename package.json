{
    "name": "@fest-lib/fl-ui",
    "description": "fest-lib FL.UI: windows, taskbar, app menu, Speed Dial (shapeless tiles). Dev: npm run dev",
    "version": "1.0.27",
    "license": "MIT",
    "type": "module",
    "sideEffects": true,
    "imports": {
        "#fl-ui/*": "./src/ui/*.ts"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fest-live/fl.ui.git"
    },
    "bugs": {
        "url": "https://github.com/fest-live/fl.ui/issues"
    },
    "homepage": "https://github.com/fest-live/fl.ui#readme",
    "keywords": [
        "fest",
        "fest-lib",
        "ui",
        "components",
        "scss"
    ],
    "files": [
        "dist",
        "src/styles",
        "LICENSE"
    ],
    "main": "./dist/fl-ui.js",
    "module": "./dist/fl-ui.js",
    "exports": {
        ".": {
            "import": "./dist/fl-ui.js",
            "default": "./dist/fl-ui.js"
        },
        "./markdown/highlight": "./src/ui/markdown/highlight.ts",
        "./markdown/raw-editor": "./src/ui/markdown/raw-editor/index.ts",
        "./markdown/render": "./src/ui/markdown/render.ts",
        "./styles": "./src/styles/index.scss",
        "./styles/core": "./src/styles/core.scss",
        "./styles/lib": "./src/styles/lib.scss",
        "./styles/patch-global-native-controls": "./src/styles/native-controls.scss",
        "./items/*": {
            "import": "./src/ui/items/*",
            "default": "./src/ui/items/*"
        },
        "./package.json": "./package.json",
        "./dist/index.js": "./dist/fl-ui.js",
        "./index.js": "./dist/fl-ui.js"
    },
    "dependencies": {
        "@fest-lib/core": ">=0.1.0",
        "@fest-lib/dom": ">=0.1.0",
        "@fest-lib/lure": ">=0.1.0",
        "@fest-lib/object": ">=0.1.0",
        "@fest-lib/style-lib": ">=0.1.0",
        "@fest-lib/uniform": ">=0.1.0",
        "highlight.js": "^11.12.0",
        "katex": "^0.16.47"
    },
    "peerDependencies": {
        "@fest-lib/core": ">=0.1.0",
        "@fest-lib/dom": ">=0.1.0",
        "@fest-lib/lure": ">=0.1.0",
        "@fest-lib/object": ">=0.1.0",
        "@fest-lib/style-lib": ">=0.1.0",
        "@fest-lib/uniform": ">=0.1.0",
        "@fest-lib/veela": ">=1.0.0"
    },
    "scripts": {
        "test": "vite --host 0.0.0.0",
        "dev": "vite --host 0.0.0.0",
        "dev:http": "VIEW_DEV_HTTP=1 vite --host 0.0.0.0",
        "dev:8434": "VIEW_DEV_PORT=8434 vite --host 0.0.0.0",
        "watch": "vite build --watch",
        "build": "vite build --config vite.config.js && npm run docs && npm run docs:md",
        "build:publish": "FEST_NPM_IMPORTS=1 vite build --config vite.config.js",
        "prepack": "npm run build:publish",
        "docs": "typedoc ./src/index.ts --options ./typedoc.json --out ./docs --tsconfig ./tsconfig.json --excludeExternals --excludePrivate --excludeProtected --skipErrorChecking",
        "docs:clean": "rm -rf ./docs && typedoc --options ./typedoc.json",
        "docs:md": "typedoc --options ./typedoc.md.json",
        "docs:md:clean": "rm -rf ./docs-md && typedoc --options ./typedoc.md.json",
        "preview": "vite preview",
        "release": "PUPPETEER_SKIP_DOWNLOAD=1 npm run build:publish && npm publish --access public --ignore-scripts",
        "publish": "node ../scripts/bump-patch-version.mjs && npm run release"
    },
    "devDependencies": {
        "@types/node": ">=26.4.1",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "markdown-it": "^15.0.1",
        "puppeteer": ">=25.10.0",
        "sass": ">=1.104.0",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.13.0",
        "typescript": "^6.0.3",
        "vite": ">=8.2.2",
        "vite-plugin-external": ">=8.0.3"
    }
}
